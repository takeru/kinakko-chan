# このファイルを keys.env にコピーして、自分の値を入れる (keys.env はGit管理外)
# キーは推測されにくい長いランダム文字列にする (例: openssl rand -hex 16)
DEVICE_KEY=change-me-device-key
ADMIN_KEY=change-me-admin-key
# デプロイ後に自分の Worker URL を入れる (きなこ側ツールとフックが参照する)
# 値はクォートしない・<> や空白を入れない (deploy.sh は sh で source し、kinako.py は = で分割して読む)
CF_BASE=https://kinako-core2-bus.YOUR-SUBDOMAIN.workers.dev
